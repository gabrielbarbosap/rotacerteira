---
import passeios from '../data/passeios.json';

interface Props {
	city: string;
}

const { city } = Astro.props;
const cidades = passeios.cidades as Record<
	string,
	{ label: string; gygCampaign: string; locationId?: number; tours: { titulo: string; url: string }[] }
>;
const data = cidades[city];
const partnerId = passeios.partnerId;
const locale = passeios.locale ?? 'pt-BR';
---

{
	data && (
		<section class="passeios">
			<h2 class="section-title">Passeios e ingressos em {data.label}</h2>
			<p>
				Reservar com antecedência evita filas. Os passeios abaixo são da GetYourGuide, uma das
				maiores e mais confiáveis plataformas de passeios e ingressos do mundo, com avaliações reais
				de viajantes e cancelamento flexível na maioria das atividades.
			</p>
			{data.locationId ? (
				<div
					data-gyg-widget="city"
					data-gyg-href="https://widget.getyourguide.com/default/city.frame"
					data-gyg-location-id={String(data.locationId)}
					data-gyg-locale-code={locale}
					data-gyg-partner-id={partnerId}
					data-gyg-cmp={data.gygCampaign}
				/>
			) : (
				<div
					data-gyg-widget="auto"
					data-gyg-locale-code={locale}
					data-gyg-partner-id={partnerId}
					data-gyg-cmp={data.gygCampaign}
				/>
			)}
		</section>
	)
}

<style>
	.passeios {
		margin: 2.5em 0;
	}
</style>
